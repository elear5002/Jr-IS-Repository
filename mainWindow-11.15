def setGoals(genid, pid):
    goalpg = tk.TK()
    goalpg.geometry("600x600")
    goalpg.config(background='blue')
    trackmymigraines= False
    trackmysleep = False
    trackpatternsmas = False
    tk.Button(goalpg, text="track my migraines", font=('Arial', 18), command=
              trackmymigraines.toggle())
    tk.Button(goalpg, text="track my sleep", font=('Arial', 18), command=
                trackmysleep.toggle())
    tk.Button(goalpg, text="track my patterns related to migraine and sleep", font=('Arial', 18), command=
                trackpatternsmas.toggle())
    if (genid == 2):
        tk.Button(goalpg, text="track my patterns related to migraine and period", font=('Arial', 18), command=
        trackpatternsmas.toggle())

        tk.Button(goalpg, text="track my patterns related to period and sleep", font=('Arial', 18), command=
        trackmysleep.toggle())
        tk.Button(goalpg, text="track my periods", font=('Arial', 18), command=
        trackmymigraines.toggle())



















