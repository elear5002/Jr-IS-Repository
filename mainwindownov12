def signup():
    global next_available_patient
    username = input("Enter your username: ")
    password = input("Enter your password: ")
    age = input("Enter your age: ")
    dob = input("Enter your date of birth: ")
    cur.execute(''' insert into patient (username, password, patient_id, age, dob) values (?, ?, ?, ?, ?)
    ''', (username, password, next_available_patient, age, dob))

    conn.commit()
    cur.execute('''
    select * from gender
    ''')

    genertable = cur.fetchall()
    for i in range(len(genertable)):
        print(genertable[i][0], genertable[i][1])
    gen_id = int(input("Enter the number that corresponds to your gender: "))
    cur.execute('''
    insert into patient_gender (patient_id, gen_id) values (?, ?)

    ''', (next_available_patient, gen_id))
    conn.commit()

    modify_goals()

    next_available_patient += 1
    query = "update next_available set next_available_patient_id = ?"
    cur.execute(query, next_available_patient)



