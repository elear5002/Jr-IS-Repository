def findAvgMigStTime():
    cur.execute('''
        select start_time from m_attack where patient_id = ?

        ''', (current_user_id))

    sts = cur.fetchall()
    average = numpy.mean(sts)

    haves = []
    have_nots = []

    for i in range(len(sts)):
        d = sts[i][0] - average
        if (d < 2):
            haves.append(d)
        else:
            have_nots.append(d)
    if (len(haves) > len(have_nots)):
        print("Your migraine attacks tend to start around ", numpy.round(average))


def findAvgMigEndTime():
    cur.execute('''
        select end_time from m_attack where patient_id = ?

        ''', (current_user_id))

